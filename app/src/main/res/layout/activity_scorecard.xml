<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:titleTextColor="#FFFFFF"/>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Match Header -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1E2D1E"
                app:cardCornerRadius="14dp"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView android:id="@+id/tvMatchTitle"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvOvers"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#9E9E9E" android:textSize="13sp"
                        android:layout_marginTop="4dp"/>
                    <TextView android:id="@+id/tvVenue"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#757575" android:textSize="12sp"
                        android:visibility="gone"/>
                    <TextView android:id="@+id/tvToss"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#757575" android:textSize="12sp"
                        android:visibility="gone"/>
                    <TextView android:id="@+id/tvResult"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#FFD700" android:textSize="15sp" android:textStyle="bold"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Innings 1 -->
            <LinearLayout
                android:id="@+id/innings1Container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1A2A1A"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone"/>

            <!-- Innings 2 -->
            <LinearLayout
                android:id="@+id/innings2Container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1A1A2A"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
