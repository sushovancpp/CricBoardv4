<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A1A0A">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:titleTextColor="#FFFFFF"/>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Match ID + refresh indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvMatchId"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="#757575"
                android:textSize="12sp"
                android:fontFamily="monospace"/>

            <TextView
                android:id="@+id/tvRefreshing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 LIVE"
                android:textColor="#F44336"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Waiting / status message -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFB300"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="visible"/>

        <!-- ══════════ LIVE LAYOUT ══════════ -->
        <LinearLayout
            android:id="@+id/liveLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Score Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1E2D1E"
                app:cardCornerRadius="14dp"
                android:layout_marginBottom="10dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:id="@+id/tvLiveBattingTeam"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:textColor="#9E9E9E"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/tvInningsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#4CAF50"
                            android:textSize="11sp"
                            android:background="#1A3A1A"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvLiveScore"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:textSize="56sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end">
                            <TextView
                                android:id="@+id/tvLiveOvers"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#9E9E9E"
                                android:textSize="18sp"
                                android:fontFamily="monospace"/>
                            <TextView
                                android:id="@+id/tvLiveCrr"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#4CAF50"
                                android:textSize="14sp"
                                android:fontFamily="monospace"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Target -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/targetCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#2D2000"
                        app:cardCornerRadius="8dp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">
                        <TextView
                            android:id="@+id/tvLiveTarget"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#FFB300"
                            android:textSize="13sp"
                            android:fontFamily="monospace"
                            android:padding="10dp"/>
                    </androidx.cardview.widget.CardView>

                    <!-- Ball Log -->
                    <LinearLayout
                        android:id="@+id/ballLogContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Batsmen Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1E2D1E"
                app:cardCornerRadius="14dp"
                android:layout_marginBottom="10dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- Striker -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:id="@+id/tvLiveStriker"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/tvLiveStrikerStats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#4CAF50"
                            android:textSize="14sp"
                            android:fontFamily="monospace"/>
                    </LinearLayout>

                    <!-- Non-striker -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvLiveNonStriker"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#BDBDBD"
                            android:textSize="14sp"/>
                        <TextView
                            android:id="@+id/tvLiveNonStrikerStats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#757575"
                            android:textSize="12sp"
                            android:fontFamily="monospace"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#333333" android:layout_marginVertical="8dp"/>

                    <!-- Bowler -->
                    <TextView
                        android:id="@+id/tvLiveBowler"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFB300"
                        android:textSize="14sp"/>
                    <TextView
                        android:id="@+id/tvLiveBowlerStats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FF8F00"
                        android:textSize="12sp"
                        android:fontFamily="monospace"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Viewer notice -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#0D1F0D"
                app:cardCornerRadius="10dp"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="👁 View-only mode · Auto-refreshing every 3s"
                    android:textColor="#4CAF50"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:padding="12dp"/>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- ══════════ COMPLETED LAYOUT ══════════ -->
        <LinearLayout
            android:id="@+id/completedLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏆 MATCH COMPLETE"
                android:textColor="#4CAF50"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvLiveResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvLiveFinalScore1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#BDBDBD"
                android:textSize="15sp"
                android:fontFamily="monospace"/>

            <TextView
                android:id="@+id/tvLiveFinalScore2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#BDBDBD"
                android:textSize="15sp"
                android:fontFamily="monospace"/>
        </LinearLayout>

    </LinearLayout>
    </ScrollView>
</LinearLayout>
