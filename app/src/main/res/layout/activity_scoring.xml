<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:titleTextColor="#FFFFFF"/>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:id="@+id/tossLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/toss_title"
                    android:textColor="#FFD700"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="24dp"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1E2D1E"
                    app:cardCornerRadius="14dp"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/who_won_toss"
                            android:textColor="#9E9E9E"
                            android:textSize="13sp"
                            android:layout_marginBottom="8dp"/>
                        <RadioGroup
                            android:id="@+id/rgTossWinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <RadioButton
                                android:id="@+id/rbTeam1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:layout_marginBottom="8dp"/>
                            <RadioButton
                                android:id="@+id/rbTeam2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"/>
                        </RadioGroup>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1E2D1E"
                    app:cardCornerRadius="14dp"
                    android:layout_marginBottom="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/elected_to"
                            android:textColor="#9E9E9E"
                            android:textSize="13sp"
                            android:layout_marginBottom="8dp"/>
                        <RadioGroup
                            android:id="@+id/rgTossChoice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <RadioButton
                                android:id="@+id/rbBat"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="@string/bat"
                                android:checked="true"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"/>
                            <RadioButton
                                android:id="@+id/rbBowl"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="@string/bowl"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"/>
                        </RadioGroup>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartMatch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/start_match"
                    android:padding="14dp"
                    android:textSize="16sp"
                    app:backgroundTint="#4CAF50"
                    app:cornerRadius="12dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/scoringLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1E2D1E"
                    app:cardCornerRadius="14dp"
                    android:layout_marginBottom="10dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvBattingTeam"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#9E9E9E"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:id="@+id/tvScore"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:textColor="#FFFFFF"
                                android:textSize="48sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace"/>
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="end">
                                <TextView
                                    android:id="@+id/tvOvers"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#9E9E9E"
                                    android:textSize="16sp"
                                    android:fontFamily="monospace"/>
                                <TextView
                                    android:id="@+id/tvCrr"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#4CAF50"
                                    android:textSize="14sp"
                                    android:fontFamily="monospace"/>
                            </LinearLayout>
                        </LinearLayout>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/targetCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="#2D2000"
                            app:cardCornerRadius="8dp"
                            android:layout_marginTop="8dp"
                            android:visibility="gone">
                            <TextView
                                android:id="@+id/tvTarget"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="#FFB300"
                                android:textSize="13sp"
                                android:fontFamily="monospace"
                                android:padding="10dp"/>
                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            android:id="@+id/ballLogContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="12dp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1E2D1E"
                    app:cardCornerRadius="14dp"
                    android:layout_marginBottom="10dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/tvStriker"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#FFFFFF"
                                    android:textSize="15sp"
                                    android:textStyle="bold"/>
                                <TextView
                                    android:id="@+id/tvStrikerStats"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#4CAF50"
                                    android:textSize="13sp"
                                    android:fontFamily="monospace"/>
                            </LinearLayout>
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSwapStrike"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/swap"
                                android:textSize="14sp"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                app:strokeColor="#4CAF50"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvNonStriker"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#BDBDBD"
                                android:textSize="14sp"/>
                            <TextView
                                android:id="@+id/tvNonStrikerStats"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#757575"
                                android:textSize="12sp"
                                android:fontFamily="monospace"/>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#333333"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvBowler"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#FFB300"
                                android:textSize="14sp"/>
                            <TextView
                                android:id="@+id/tvBowlerStats"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#FF8F00"
                                android:textSize="12sp"
                                android:fontFamily="monospace"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSetBowler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/set_bowler"
                    android:textSize="15sp"
                    android:padding="12dp"
                    app:backgroundTint="#2D1A00"
                    app:strokeColor="#FFB300"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="#FFB300"
                    android:visibility="gone"
                    android:layout_marginBottom="10dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddBatsman"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_new_batsman"
                    android:textSize="15sp"
                    android:padding="12dp"
                    app:backgroundTint="#001A2D"
                    app:strokeColor="#2196F3"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="#2196F3"
                    android:visibility="gone"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:id="@+id/scoringButtonsLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#1E2D1E"
                        app:cardCornerRadius="14dp"
                        android:layout_marginBottom="10dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="8dp">
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn0"
                                    android:layout_width="0dp"
                                    android:layout_height="64dp"
                                    android:layout_weight="1"
                                    android:text="@string/score_0"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    app:backgroundTint="#2A2A2A"
                                    app:cornerRadius="10dp"
                                    android:layout_marginEnd="6dp"/>
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn1"
                                    android:layout_width="0dp"
                                    android:layout_height="64dp"
                                    android:layout_weight="1"
                                    android:text="@string/score_1"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    app:backgroundTint="#1A3A1A"
                                    app:cornerRadius="10dp"
                                    android:layout_marginEnd="6dp"/>
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn2"
                                    android:layout_width="0dp"
                                    android:layout_height="64dp"
                                    android:layout_weight="1"
                                    android:text="@string/score_2"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    app:backgroundTint="#1A3A1A"
                                    app:cornerRadius="10dp"
                                    android:layout_marginEnd="6dp"/>
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn3"
                                    android:layout_width="0dp"
                                    android:layout_height="64dp"
                                    android:layout_weight="1"
                                    android:text="@string/score_3"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    app:backgroundTint="#1A3A1A"
                                    app:cornerRadius="10dp"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="8dp">
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn4"
                                    android:layout_width="0dp"
                                    android:layout_height="64dp"
                                    android:layout_weight="1"
                                    android:text="@string/score_4"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    app:backgroundTint="#0D2A4A"
                                    app:cornerRadius="10dp"
                                    android:layout_marginEnd="6dp"/>
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn6"
                                    android:layout_width="0dp"
                                    android:layout_height="64dp"
                                    android:layout_weight="1"
                                    android:text="@string/score_6"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    app:backgroundTint="#2A0D4A"
                                    app:cornerRadius="10dp"
                                    android:layout_marginEnd="6dp"/>
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnWide"
                                    android:layout_width="0dp"
                                    android:layout_height="64dp"
                                    android:layout_weight="1"
                                    android:text="@string/score_wd"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    app:backgroundTint="#3A2A00"
                                    app:cornerRadius="10dp"
                                    android:layout_marginEnd="6dp"/>
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnNoBall"
                                    android:layout_width="0dp"
                                    android:layout_height="64dp"
                                    android:layout_weight="1"
                                    android:text="@string/score_nb"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    app:backgroundTint="#3A1A00"
                                    app:cornerRadius="10dp"/>
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnWicket"
                                android:layout_width="match_parent"
                                android:layout_height="64dp"
                                android:text="@string/out"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                app:backgroundTint="#4A0000"
                                app:cornerRadius="10dp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnViewScorecard"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/scorecard"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            app:strokeColor="#4CAF50"
                            android:textColor="#4CAF50"
                            android:layout_marginEnd="8dp"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEndMatch"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/end_match"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            app:strokeColor="#F44336"
                            android:textColor="#F44336"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/inningsBreakLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/innings_break"
                    android:textColor="#FFB300"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>
                <TextView
                    android:id="@+id/tvInnBreakScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#BDBDBD"
                    android:textSize="16sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:id="@+id/tvInnBreakTarget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFD700"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartSecondInnings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/start_2nd_innings"
                    android:textSize="16sp"
                    android:padding="14dp"
                    app:backgroundTint="#4CAF50"
                    app:cornerRadius="12dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/completedLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/match_complete"
                    android:textColor="#4CAF50"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>
                <TextView
                    android:id="@+id/tvResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="16dp"/>
                <TextView
                    android:id="@+id/tvFinalScore1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#BDBDBD"
                    android:textSize="15sp"
                    android:fontFamily="monospace"/>
                <TextView
                    android:id="@+id/tvFinalScore2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#BDBDBD"
                    android:textSize="15sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="24dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewScorecardCompleted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/view_full_scorecard"
                    android:textSize="15sp"
                    app:backgroundTint="#1A3A1A"
                    app:strokeColor="#4CAF50"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="#4CAF50"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>